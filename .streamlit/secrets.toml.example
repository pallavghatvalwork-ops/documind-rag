# Copy to .streamlit/secrets.toml (do NOT commit the copied file)
# Hosted deployment uses this API instead of your saved 8B LoRA model.
LLM_API_KEY = "YOUR_GROQ_API_KEY"
LLM_BASE_URL = "https://api.groq.com/openai/v1"
LLM_MODEL = "openai/gpt-oss-20b"
# LORA_ADAPTER_PATH = "/local/path/to/llama_model"  # only for GPU deployment
